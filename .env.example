# ==============================================================================
# BountyFi environment template. Copy to .env and fill in. Never commit .env.
# ==============================================================================

# --- Server ---------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Browser origins allowed to call the API directly. Not needed when nginx proxies /api on the same origin.
CORS_ORIGIN=http://localhost:5173
# Local development: postgresql://postgres:<password>@localhost:5432/fixbounty
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Arc chain ------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# BountyBoard v2 address and the block it was deployed in (the indexer starts there).
# If INDEXER_START_BLOCK is empty the server searches for the deployment block itself.
BOUNTY_BOARD_ADDRESS=
INDEXER_START_BLOCK=

# Wallet that receives every platform fee. Baked into the contract at deployment.
TREASURY_ADDRESS=

# --- Wallet connection -------------------------------------------------------------
# From https://cloud.reown.com. Leave empty to offer browser wallets only.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Browser to API ------------------------------------------------------------------
VITE_API_URL=/api

# --- Google sign-in (Firebase) ------------------------------------------------------
# Firebase console: Authentication > Sign-in method > Google, and add your domain under Settings > Authorized domains.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Admin access -----------------------------------------------------------------------
# Comma separated Google e-mails that can open /admin. Matched against the verified e-mail on the ID token.
ADMIN_EMAILS=

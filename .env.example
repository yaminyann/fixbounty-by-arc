# ==============================================================================
# FixBounty Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and provide your specific credentials.
# NEVER commit your actual `.env` file or any private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Backend Data Store)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# In local Docker Compose: host is 'postgres'
# In local bare metal: host is 'localhost'
DATABASE_URL="postgresql://fixbounty:fixbounty_secure_pass@postgres:5432/fixbounty"

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Arc Testnet RPC URL for server-side verification and balance lookups
ARC_RPC_URL="https://rpc.testnet.arc.io"

# Firebase Project ID used by the backend to verify Google ID tokens via Google JWKS
FIREBASE_PROJECT_ID="fixbounty-app"

# ------------------------------------------------------------------------------
# 3. Firebase Client Configuration (Frontend Authentication)
# ------------------------------------------------------------------------------
# Obtain these values from your Firebase Project Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app
#
# REQUIRED SETUP IN FIREBASE CONSOLE:
# 1. Authentication -> Sign-in method -> Enable "Google".
# 2. Authentication -> Settings -> Authorized domains -> Add "localhost", "127.0.0.1",
#    and your Coolify/production domain (e.g., "fixbounty.yourdomain.com").
# 3. Firestore Database (optional display cache) -> Create in production mode.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="fixbounty-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="fixbounty-app"
VITE_FIREBASE_STORAGE_BUCKET="fixbounty-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: Base URL for backend API if not using reverse proxy / same-domain routing
# VITE_API_BASE_URL=""

# ------------------------------------------------------------------------------
# 4. Smart Contract Configuration (Arc Testnet)
# ------------------------------------------------------------------------------
# Deployed BountyBoard smart contract address on Arc Testnet (Chain ID: 5042002).
# Verified deployment address on Arc Testnet explorer:
# https://explorer.testnet.arc.io/address/0x489cfbd95e8f5a934b7ab1e0fe7a89fa3d0527fb
# ------------------------------------------------------------------------------
VITE_BOUNTY_BOARD_ADDRESS="0x489cfbd95e8f5a934b7ab1e0fe7a89fa3d0527fb"
USDC_ADDRESS="0x3600000000000000000000000000000000000000"

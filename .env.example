# ==============================================================================
# TaskFi — Production & Hosting Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and configure for your deployment environment.
# Supported environments: Local Docker Compose, Coolify, VPS, Railway, Render.
# NEVER commit your actual `.env` file or any private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Backend Data Store)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# - In local Docker Compose: host is 'postgres'
# - In Coolify / Cloud VPS: provide your provisioned Postgres connection URL
# - In bare metal: host is 'localhost'
DATABASE_URL="postgresql://taskfi:taskfi_secure_pass@postgres:5432/taskfi"

# Individual database credentials (used by docker-compose postgres service):
POSTGRES_USER="taskfi"
POSTGRES_PASSWORD="taskfi_secure_pass"
POSTGRES_DB="taskfi"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV="production"

# Allowed CORS origins (comma-separated list of your frontend production domains):
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://taskfi.yourdomain.com"

# Arc Testnet RPC URL for server-side verification and balance lookups:
ARC_RPC_URL="https://rpc.testnet.arc.io"

# Firebase Project ID used by the backend to verify Google ID tokens via Google JWKS:
FIREBASE_PROJECT_ID="focus-timeer-project"

# ------------------------------------------------------------------------------
# 3. Firebase Client Configuration (Frontend Authentication)
# ------------------------------------------------------------------------------
# Obtain these values from your Firebase Project Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app
#
# REQUIRED SETUP IN FIREBASE CONSOLE:
# 1. Authentication -> Sign-in method -> Enable "Google".
# 2. Authentication -> Settings -> Authorized domains -> Add "localhost", "127.0.0.1",
#    and your production domain (e.g., "taskfi.yourdomain.com").
# 3. Firestore Database -> Create in production mode (for optional display cache).
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyCMoG9HTv4oVMCUUrQhtMnyLCy1x8FAG20"
VITE_FIREBASE_AUTH_DOMAIN="focus-timeer-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="focus-timeer-project"
VITE_FIREBASE_STORAGE_BUCKET="focus-timeer-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="908631720415"
VITE_FIREBASE_APP_ID="1:908631720415:web:647aa62f3c39b2b5dd446a"
VITE_FIREBASE_MEASUREMENT_ID="G-QDTZEXKPL6"

# Optional: Base URL for backend API if frontend and backend are hosted on separate domains
# (e.g., "https://api.taskfi.yourdomain.com"). Leave empty if using reverse-proxy routing:
VITE_API_BASE_URL=""

# ------------------------------------------------------------------------------
# 4. Smart Contract Configuration (Arc Testnet)
# ------------------------------------------------------------------------------
# Deployed BountyBoard smart contract address on Arc Testnet (Chain ID: 5042002).
# Verified deployment address on Arc Testnet explorer:
# https://explorer.testnet.arc.io/address/0x489cfbd95e8f5a934b7ab1e0fe7a89fa3d0527fb
# ------------------------------------------------------------------------------
VITE_BOUNTY_BOARD_ADDRESS="0x489cfbd95e8f5a934b7ab1e0fe7a89fa3d0527fb"
USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# Target Network: 'testnet' (Chain ID 5042002) or 'mainnet' (Chain ID 5042)
VITE_ACTIVE_NETWORK="testnet"

# ------------------------------------------------------------------------------
# 5. Administrative Console Credentials & Access Control
# ------------------------------------------------------------------------------
# Passkey for accessing the /admin dashboard:
VITE_ADMIN_PASSWORD="taskfi_admin_2026_arc"
ADMIN_PASSWORD="taskfi_admin_2026_arc"
ADMIN_SECRET="taskfi_admin_2026_arc"

# Comma-separated list of whitelisted Google OAuth emails granted automatic admin access:
VITE_ADMIN_EMAILS="yaminv75@gmail.com,admin@taskfi.io"
ADMIN_EMAILS="yaminv75@gmail.com,admin@taskfi.io"


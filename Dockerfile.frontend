# Stage 1: Build the Vite production bundle
FROM oven/bun:1.2-slim AS builder

WORKDIR /app

# Ensure devDependencies (vite, typescript, tailwindcss, etc.) are installed even if Coolify/Docker sets NODE_ENV=production
ENV NODE_ENV=development

# Accept build arguments from Coolify/Docker
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_MEASUREMENT_ID
ARG VITE_BOUNTY_BOARD_ADDRESS
ARG ARC_RPC_URL

ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID \
    VITE_FIREBASE_MEASUREMENT_ID=$VITE_FIREBASE_MEASUREMENT_ID \
    VITE_BOUNTY_BOARD_ADDRESS=$VITE_BOUNTY_BOARD_ADDRESS \
    VITE_ARC_RPC_URL=$ARC_RPC_URL \
    NODE_OPTIONS="--max-old-space-size=2048"

# Copy dependency specifications
COPY package.json bun.lock ./

# Install all dependencies including devDependencies (forcing --production=false)
RUN bun install --frozen-lockfile --production=false || bun install --production=false

# Copy source code and build configuration
COPY . .

# Build the production static assets
RUN bun run build

# Stage 2: Serve using high-performance Nginx with reverse proxy
FROM nginx:alpine

# Install curl for health checking
RUN apk add --no-cache curl

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

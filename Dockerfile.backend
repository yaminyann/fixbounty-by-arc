FROM oven/bun:1.2-alpine

WORKDIR /app

# curl is only for the container healthcheck
RUN apk add --no-cache curl

# Install exactly what the lockfile says. The build fails if the lockfile and package.json disagree.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

COPY server/ ./server/

ENV NODE_ENV=production \
    PORT=4000

# Never run the API as root
USER bun

EXPOSE 4000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:4000/health || exit 1

# Applies pending migrations, starts the chain indexer, then serves the API
CMD ["bun", "run", "server/src/index.ts"]
